#!/bin/bash -e
# Regenerate the MariaDB password used by the sample application.

. /etc/default/inithooks

umask 077
PASSWORD=$(mcookie)

aspnet_src_config=/var/www/aspnetcore-src/appsettings.json
aspnet_bin_config=/var/www/aspnetcore/appsettings.json
config_tmp=$(mktemp "$aspnet_src_config.XXXXXXXX")
python3 - "$aspnet_src_config" "$config_tmp" <<PY
import json
import re
import sys

source, target = sys.argv[1:]
with open(source, encoding="utf-8") as stream:
    config = json.load(stream)
connection = config["ConnectionStrings"]["ExampleContext"]
config["ConnectionStrings"]["ExampleContext"] = re.sub(
    r"Password=[^;]*;", "Password=$PASSWORD;", connection
)
with open(target, "w", encoding="utf-8") as stream:
    json.dump(config, stream, indent=2)
    stream.write("\n")
PY
chown root:www-data "$config_tmp"
chmod 0640 "$config_tmp"
mv "$config_tmp" "$aspnet_src_config"
install -o root -g www-data -m 0640 "$aspnet_src_config" "$aspnet_bin_config"

$INITHOOKS_PATH/bin/mysqlconf.py --user=aspnet --pass="$PASSWORD"

systemctl restart aspnetcore
