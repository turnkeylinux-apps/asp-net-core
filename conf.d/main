#!/bin/bash -e

set -x

## mysql setup

DB_NAME=example
DB_USER=aspnet
DOTNET_CHANNEL=10.0
EF_VERSION=9.0.19
MYSQL_EF_VERSION=9.0.0
MICROSOFT_KEY_FINGERPRINT=AA86F75E427A19DD33346403EE4D7792F748182B
MICROSOFT_KEY_SHA256=d45224d594d969f084232deaaf97c58ca502a9d964c362d7aaef5a76e16b3dd1

service mysql start

mysqladmin create "$DB_NAME"
set +x
DB_PASS=$(mcookie)
mysql --batch <<EOF
CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
EOF
unset DB_PASS
set -x

service mysql stop

## aspdotnet setup

# Microsoft package feed key
key_tmp=$(mktemp)
curl --fail --location --silent --show-error \
    --output "$key_tmp" https://packages.microsoft.com/keys/microsoft-2025.asc
printf '%s  %s\n' "$MICROSOFT_KEY_SHA256" "$key_tmp" | sha256sum -c -
test "$(gpg --batch --show-keys --with-colons "$key_tmp" |
    awk -F: '$1 == "fpr" {print $10; exit}')" = "$MICROSOFT_KEY_FINGERPRINT"
gpg --batch --dearmor --output /usr/share/keyrings/microsoft.gpg "$key_tmp"
find "$key_tmp" -maxdepth 0 -delete
chmod 0644 /usr/share/keyrings/microsoft.gpg

export DOTNET_CLI_TELEMETRY_OPTOUT=1
APP_SRC_ROOT='/var/www/aspnetcore-src'
APP_ROOT='/var/www/aspnetcore'

apt update
apt install -y \
    "dotnet-sdk-$DOTNET_CHANNEL" \
    "aspnetcore-runtime-$DOTNET_CHANNEL"

adduser --disabled-login --gecos 'aspnet' aspnet
chown -R aspnet:aspnet /home/aspnet

mkdir "$APP_SRC_ROOT" "$APP_ROOT"
# remove & move files from tklweb-cp
find /var/www/js /var/www/css -depth -delete

chown -R aspnet:www-data "$APP_ROOT"
chown -R aspnet:www-data "$APP_SRC_ROOT"

su -s /bin/bash - aspnet <<EOF
export DOTNET_CLI_TELEMETRY_OPTOUT=1
APP_SRC_ROOT='/var/www/aspnetcore-src'
APP_ROOT='/var/www/aspnetcore'

cd /var/www
dotnet new webapp --framework net10.0 -o aspnetcore-src -n TurnkeyExampleApp
cd aspnetcore-src
dotnet add package Microsoft.EntityFrameworkCore.Relational --version $EF_VERSION
dotnet add package Pomelo.EntityFrameworkCore.MySql --version $MYSQL_EF_VERSION

# copy aspnet site source (minus project data)
rsync -r /usr/local/src/aspnetcore-src /var/www/

# prepare & build webapp
sed -i 's|https://localhost:5001;||' $APP_SRC_ROOT/Properties/launchSettings.json


cd "$APP_SRC_ROOT"
dotnet restore --use-lock-file
dotnet restore --locked-mode
dotnet publish --no-restore --configuration Release -o "$APP_ROOT"
EOF

mv /var/www/images "$APP_SRC_ROOT/wwwroot"
cp -r "$APP_SRC_ROOT/wwwroot/images" "$APP_ROOT/wwwroot"
chown -R aspnet:www-data "$APP_SRC_ROOT/wwwroot/images"
chown -R aspnet:www-data "$APP_ROOT/wwwroot/images"

install -d -m 0755 /usr/local/share/turnkey-aspnetcore
sdk_version=$(dotnet --version)
lock_sha256=$(sha256sum "$APP_SRC_ROOT/packages.lock.json" | awk '{print $1}')
cat >/usr/local/share/turnkey-aspnetcore/source <<EOF
dotnet_channel=$DOTNET_CHANNEL
sdk_version=$sdk_version
ef_version=$EF_VERSION
mysql_ef_version=$MYSQL_EF_VERSION
lock_sha256=$lock_sha256
microsoft_key_fingerprint=$MICROSOFT_KEY_FINGERPRINT
microsoft_feed=https://packages.microsoft.com/debian/13/prod
nuget_feed=https://api.nuget.org/v3/index.json
EOF

chown root:www-data "$APP_SRC_ROOT/appsettings.json" "$APP_ROOT/appsettings.json"
chmod 0640 "$APP_SRC_ROOT/appsettings.json" "$APP_ROOT/appsettings.json"

# cleanup
find /usr/local/src/aspnetcore-src -depth -delete

# setup nginx for reverse proxy
rm /etc/nginx/sites-enabled/default
ln -s /etc/nginx/sites-available/aspnetcore /etc/nginx/sites-enabled/aspnetcore

# setup services
systemctl enable aspnetcore.service
mkdir -m 0755 /var/log/aspnet
